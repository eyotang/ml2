{
  "name": "zhilian-quiz",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run prepare:data && vite --host 127.0.0.1",
    "prepare:data": "node scripts/prepare-data.mjs",
    "build": "npm run prepare:data && vite build",
    "test": "npm run prepare:data && vitest run",
    "preview": "vite preview --host 127.0.0.1",
    "format:check": "prettier --check \"src/**/*.{jsx,js}\" \"tests/*.{js,jsx}\" \"scripts/*.mjs\" vite.config.js"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
